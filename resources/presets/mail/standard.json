{
  "theme": {},
  "blocks": [
    {"id": "header", "type": "header", "props": {"logo": "auto", "tagline": "@report.header", "bg": "primary"}},
    {"id": "sp1", "type": "spacer", "props": {"height": 24}},
    {"id": "greeting", "type": "text", "props": {"html": "<p>@mail.greeting_plain</p><p>@mail.intro_plain</p>", "space": "m"}},
    {"id": "grade", "type": "grade_box", "props": {"show_summary": true, "space": "m"}},
    {"id": "measures", "type": "measures", "props": {"title": "@mail.measures_title", "max": 3, "space": "m"}},
    {"id": "pdf", "type": "pdf_note", "props": {"html": "<p>@mail.pdf_note</p>", "space": "m"}},
    {"id": "offer", "type": "text", "props": {"html": "<p>@mail.offer</p>", "space": "m"}},
    {"id": "cta", "type": "button", "props": {"label": "@mail.cta", "target": "contact", "alt": "@mail.cta_alt", "style": "accent", "space": "m"}},
    {"id": "nl", "type": "newsletter_note", "props": {"html": "<p>@mail.newsletter_note</p>", "space": "m"}},
    {"id": "sig", "type": "signature", "props": {"show_portrait": true, "space": "l"}},
    {"id": "footer", "type": "footer", "props": {"html": "<p>@mail.footer_plain</p>"}}
  ]
}
