{% trans_default_domain 'neo_websitecheck' %}
{# Shared e-mail frame (inline styles; 600 px, works in Outlook/Gmail/Apple Mail). #}
{% set p = brand.color_primary %}
{% set a = brand.color_accent %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><title>{% block title %}{% endblock %}</title></head>
<body style="margin:0;padding:0;background:#f1eff7;font-family:Helvetica,Arial,sans-serif;color:#222;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f1eff7;padding:24px 12px;"><tr><td align="center">
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;background:#ffffff;border-radius:14px;overflow:hidden;">
  <tr><td style="background:{{ p }};padding:20px 28px;">
    <table role="presentation" width="100%"><tr>
      <td style="color:#fff;font-weight:bold;font-size:18px;">{% if brand.logo_data %}<img src="{{ brand.logo_data }}" alt="{{ brand.name }}" style="height:26px;display:block;">{% else %}{{ brand.name }}{% endif %}</td>
      <td align="right" style="color:{{ a }};font-size:11px;letter-spacing:2px;text-transform:uppercase;font-family:Menlo,Consolas,monospace;">{{ 'report.header'|trans }}</td>
    </tr></table>
  </td></tr>
  <tr><td style="padding:28px;font-size:16px;line-height:1.6;">
    {% block body %}{% endblock %}
  </td></tr>
  <tr><td style="padding:16px 28px;background:#f6f5fb;font-size:12px;line-height:1.6;color:#666;">
    {% block footer %}{% endblock %}
  </td></tr>
</table>
</td></tr></table>
</body>
</html>
