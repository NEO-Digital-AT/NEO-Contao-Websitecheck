{% extends '@Contao/neo_websitecheck/_mail_base.html.twig' %}
{% trans_default_domain 'neo_websitecheck' %}
{% block title %}{{ 'mail.subject'|trans({'%domain%': result.domain, '%grade%': result.grade, '%word%': result.gradeWord}) }}{% endblock %}
{% block body %}
  {% set p = brand.color_primary %}{% set a = brand.color_accent %}
  {% set gradeBg = result.grade <= 2 ? a : (result.grade == 3 ? '#ffb020' : '#ff6b73') %}
  <p style="margin:0 0 14px;">{{ 'mail.greeting'|trans({'%name%': first_name}) }}</p>
  <p style="margin:0 0 14px;">{{ 'mail.intro'|trans({'%domain%': result.domain, '%pages%': result.pagesChecked}) }}</p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:18px 0 22px;background:#f6f5fb;border:1px solid #e3e1ea;border-radius:12px;"><tr>
    <td style="padding:16px;width:64px;"><div style="width:64px;height:64px;border-radius:12px;background:{{ gradeBg }};color:{{ p }};font-size:32px;font-weight:bold;text-align:center;line-height:64px;">{{ result.grade ?: '–' }}</div></td>
    <td style="padding:16px 16px 16px 0;"><b style="color:{{ p }};font-size:17px;">{{ 'mail.grade_line'|trans({'%grade%': result.grade, '%word%': result.gradeWord}) }}</b><br><span style="font-size:14px;color:#555;">{{ result.summary }}</span></td>
  </tr></table>
  {% if result.measures %}
  <p style="margin:0 0 8px;"><b>{{ 'mail.measures_title'|trans }}</b></p>
  <ol style="margin:0 0 20px;padding-left:22px;">
    {% for m in result.measures %}<li style="margin-bottom:10px;"><b style="color:{{ p }};">{{ m.title }}.</b> {{ m.text }}</li>{% endfor %}
  </ol>
  {% endif %}
  {% if check.pdf_path %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 22px;border:1px dashed #b9b4cc;border-radius:12px;"><tr>
    <td style="padding:12px 14px;width:38px;"><div style="width:38px;height:38px;border-radius:9px;background:{{ p }};color:{{ a }};font:bold 11px Menlo,Consolas,monospace;text-align:center;line-height:38px;">PDF</div></td>
    <td style="padding:12px 14px 12px 0;font-size:14px;">{{ 'mail.pdf_note'|trans }}</td>
  </tr></table>
  {% endif %}
  <p style="margin:0 0 18px;">{{ 'mail.offer'|trans }}</p>
  {% if contact_url %}
  <p style="margin:0 0 24px;"><a href="{{ contact_url }}" style="display:inline-block;padding:13px 22px;border-radius:999px;background:{{ a }};color:{{ p }};font-weight:bold;text-decoration:none;">{{ 'mail.cta'|trans }}</a> <span style="font-size:14px;color:#666;">&nbsp;{{ 'mail.cta_alt'|trans }}</span></p>
  {% endif %}
  {% if newsletter %}
  <p style="margin:0 0 18px;padding:12px 14px;border-radius:12px;background:#f3fbe4;border:1px solid #cde79a;font-size:14px;">{{ 'mail.newsletter_note'|trans }}</p>
  {% endif %}
  <table role="presentation" cellpadding="0" cellspacing="0" style="border-top:1px solid #e3e1ea;padding-top:18px;margin-top:6px;width:100%;"><tr>
    {% if brand.portrait_data %}<td style="width:70px;padding-top:18px;"><img src="{{ brand.portrait_data }}" alt="" width="56" height="56" style="width:56px;height:56px;border-radius:50%;display:block;"></td>{% endif %}
    <td style="padding-top:18px;font-size:14px;line-height:1.5;"><b style="color:{{ p }};">{{ brand.owner_name ?: brand.name }}</b><br>{% if brand.owner_name %}{{ brand.name }}<br>{% endif %}{{ [brand.phone, brand.website_url]|filter(v => v)|join(' · ') }}</td>
  </tr></table>
{% endblock %}
{% block footer %}
  {{ 'mail.footer'|trans({'%domain%': result.domain, '%days%': retention_days}) }}
{% endblock %}
