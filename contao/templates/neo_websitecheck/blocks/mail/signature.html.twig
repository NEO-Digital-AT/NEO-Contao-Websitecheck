<tr><td style="padding:0 28px {{ t.space_px[block.space] }};">
  <table role="presentation" cellpadding="0" cellspacing="0" style="border-top:1px solid {{ t.line }};padding-top:18px;margin-top:6px;width:100%;"><tr>
    {% if block.show_portrait and brand.portrait_data %}<td style="width:70px;padding-top:18px;"><img src="{{ brand.portrait_data }}" alt="" width="56" height="56" style="width:56px;height:56px;border-radius:50%;display:block;"></td>{% endif %}
    <td style="padding-top:18px;font-size:14px;line-height:1.5;">{{ block.html ?: ('<b style="color:' ~ t.primary ~ '">' ~ (brand.owner_name ?: brand.name) ~ '</b><br>' ~ (brand.owner_name ? brand.name ~ '<br>' : '') ~ [brand.phone, brand.website_url]|filter(v => v)|join(' · '))|raw }}</td>
  </tr></table>
</td></tr>
