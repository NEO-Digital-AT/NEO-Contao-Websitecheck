<tr><td style="padding:0 28px {{ t.space_px[block.space] }};">
  {% if block.title %}<p style="margin:0 0 8px;"><b>{{ block.title }}</b></p>{% endif %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;">
    {% for area in result.areas %}<tr><td style="padding:4px 8px 4px 0;width:28px;vertical-align:top;"><span style="display:inline-block;min-width:22px;padding:3px 0;border-radius:6px;background:{{ t.grade_bg[area.grade] }};color:{{ t.grade_ink[area.grade] }};font-weight:bold;text-align:center;line-height:1;">{{ area.grade ?: '–' }}</span></td><td style="padding:4px 0;vertical-align:top;"><b style="color:{{ t.primary }};">{{ area.label }}</b> – {{ area.summary }}</td></tr>{% endfor %}
  </table>
</td></tr>
