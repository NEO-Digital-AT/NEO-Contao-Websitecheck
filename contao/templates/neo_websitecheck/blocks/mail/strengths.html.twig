{% if result.strengths %}
<tr><td style="padding:0 28px {{ t.space_px[block.space] }};">
  {% if block.title %}<p style="margin:0 0 8px;"><b>{{ block.title }}</b></p>{% endif %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;">{% for s in result.strengths|slice(0, block.max) %}<tr><td style="padding:3px 8px 3px 0;width:22px;color:#2d7a2d;font-weight:bold;">✓</td><td style="padding:3px 0;"><b>{{ s.title }}</b>{% if s.text %} – {{ s.text }}{% endif %}</td></tr>{% endfor %}</table>
</td></tr>
{% endif %}
