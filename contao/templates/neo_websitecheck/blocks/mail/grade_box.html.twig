<tr><td style="padding:0 28px {{ t.space_px[block.space] }};">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:{{ t.soft }};border:1px solid {{ t.line }};border-radius:{{ t.rpx }};"><tr>
    <td style="padding:16px;width:64px;"><div style="width:64px;height:64px;border-radius:12px;background:{{ t.grade_bg[result.grade] }};color:{{ t.grade_ink[result.grade] }};font-size:32px;font-weight:bold;text-align:center;line-height:64px;">{{ result.grade ?: '–' }}</div></td>
    <td style="padding:16px 16px 16px 0;"><b style="color:{{ t.primary }};font-size:17px;">{{ block.grade_line }}</b>{% if block.show_summary %}<br><span style="font-size:14px;color:#555;">{{ result.summary }}</span>{% endif %}</td>
  </tr></table>
</td></tr>
