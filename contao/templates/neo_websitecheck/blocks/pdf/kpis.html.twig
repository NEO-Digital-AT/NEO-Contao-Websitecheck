{% if areas.speed.kpis is defined and areas.speed.kpis %}
<div style="margin-bottom:{{ t.space[block.space] }};page-break-inside:avoid">
{% for row in areas.speed.kpis|batch(3) %}
<table style="width:100%;border-collapse:separate;border-spacing:2.5mm 0;margin:0 -2.5mm 2.5mm"><tr>
  {% for k in row %}<td style="width:33%;padding:3mm;background:{{ t.soft }};border:1px solid {{ t.line }};border-radius:{{ t.r }};vertical-align:top"><small style="display:block;font-size:6.8pt;letter-spacing:.08em;text-transform:uppercase;color:{{ t.muted }}">{{ k.label }}</small><b style="display:block;font-size:13pt;color:{{ t.primary }};margin:.5mm 0">{{ k.value }}</b><em style="font-style:normal;font-size:8pt;color:{{ k.ok ? '#2d7a2d' : '#8a5a00' }}">{{ k.note }}</em></td>{% endfor %}
</tr></table>
{% endfor %}
</div>
{% endif %}
