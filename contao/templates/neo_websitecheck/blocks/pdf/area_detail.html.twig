{% trans_default_domain 'neo_websitecheck' %}
{% set ar = areas[block.area]|default(null) %}
{% if ar %}
<div style="margin-bottom:{{ t.space[block.space] }}">
  <div style="page-break-after:avoid;page-break-inside:avoid">
  {% if block.show_grade %}<p class="eyebrow">{{ 'report.grade_short'|trans({'%grade%': ar.grade, '%word%': ar.grade ? ('grade.' ~ ar.grade)|trans : ''}) }}</p>{% endif %}
  <h2>{{ block.title ?: ar.label }}</h2>
  {% if block.intro %}<p class="muted">{{ block.intro|nl2br }}</p>{% endif %}
  </div>
  {% if block.show_kpis and ar.kpis is defined and ar.kpis %}
  <table style="width:100%;border-collapse:separate;border-spacing:2.5mm 0;margin:0 -2.5mm 4mm"><tr>
    {% for k in ar.kpis|slice(0, 3) %}<td style="width:33%;padding:3mm;background:{{ t.soft }};border:1px solid {{ t.line }};border-radius:{{ t.r }};vertical-align:top"><small style="display:block;font-size:6.8pt;letter-spacing:.08em;text-transform:uppercase;color:{{ t.muted }}">{{ k.label }}</small><b style="display:block;font-size:13pt;color:{{ t.primary }};margin:.5mm 0">{{ k.value }}</b><em style="font-style:normal;font-size:8pt;color:{{ k.ok ? '#2d7a2d' : '#8a5a00' }}">{{ k.note }}</em></td>{% endfor %}
  </tr></table>
  {% endif %}
  {% set withCrops = block.show_crops and block.area == 'accessibility' and crops %}
  <table class="two"><tr>
    {% if withCrops %}
    <td class="l">
      {% for crop in crops|slice(0, 2) %}<div class="crop"><img src="{{ crop.data }}" alt=""></div><p class="caption">{{ crop.title }}{% if crop.text %} · „{{ crop.text|slice(0, 60) }}“{% endif %}</p>{% endfor %}
    </td>
    <td class="r">
      {% for issue in ar.issues|slice(0, block.max_issues) %}<table class="finding"><tr><td class="i"><span class="dot warn">!</span></td><td class="t"><b>{{ issue.title }}</b>{{ issue.text }}{% if issue.examples is defined and issue.examples %}<small>{{ issue.examples|join(' · ') }}</small>{% endif %}</td></tr></table>{% endfor %}
      {% for good in ar.good|slice(0, block.max_good) %}<table class="finding"><tr><td class="i"><span class="dot good">✓</span></td><td class="t"><b>{{ good.title }}</b>{{ good.text }}</td></tr></table>{% endfor %}
    </td>
    {% else %}
    <td class="l">
      <h4>{{ 'report.what_works'|trans }}</h4>
      {% for good in ar.good|slice(0, block.max_good) %}<table class="finding"><tr><td class="i"><span class="dot good">✓</span></td><td class="t"><b>{{ good.title }}</b>{{ good.text }}</td></tr></table>{% else %}<p class="muted">–</p>{% endfor %}
    </td>
    <td class="r">
      <h4>{{ 'report.what_to_improve'|trans }}</h4>
      {% for issue in ar.issues|slice(0, block.max_issues) %}<table class="finding"><tr><td class="i"><span class="dot warn">!</span></td><td class="t"><b>{{ issue.title }}</b>{{ issue.text }}{% if issue.examples is defined and issue.examples %}<small>{{ issue.examples|join(' · ') }}</small>{% endif %}</td></tr></table>{% else %}<p class="muted">{{ 'report.nothing_to_improve'|trans }}</p>{% endfor %}
    </td>
    {% endif %}
  </tr></table>
  {% if block.area == 'content' and result.firstImpression %}<p class="muted" style="font-size:9pt">„{{ result.firstImpression }}“</p>{% endif %}
  {% if block.note %}<p class="note">{{ block.note|nl2br }}</p>{% elseif ar.note is defined and ar.note %}<p class="note">{{ ar.note }}</p>{% endif %}
</div>
{% endif %}
