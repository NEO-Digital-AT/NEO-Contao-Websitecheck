{% import '@Contao/neo_websitecheck/_pdf_macros.html.twig' as pdf %}
<div style="margin-bottom:{{ t.space[block.space] }}">
{% if block.eyebrow %}<p class="eyebrow">{{ block.eyebrow }}</p>{% endif %}
{% if block.title %}<h2>{{ block.title }}</h2>{% endif %}
{% set legendHtml %}
  <table class="card" style="width:100%;border-collapse:collapse;background:{{ t.soft }}"><tr>
    <td style="width:12mm;padding:2.2mm 0 2.2mm 2.2mm;vertical-align:top">{{ pdf.badge('?', 9, 10, t.primary, t.accent, '2.5mm') }}</td>
    <td style="padding:2.2mm;vertical-align:top">{% if block.legend_title %}<b style="display:block;font-size:9.5pt;color:{{ t.primary }}">{{ block.legend_title }}</b>{% endif %}{% if block.legend_text %}<p style="font-size:8.2pt;margin:.5mm 0 1.5mm;line-height:1.3">{{ block.legend_text|nl2br }}</p>{% endif %}
      {{ pdf.legend(t, t.labels.grade) }}</td>
  </tr></table>
{% endset %}
{% if block.layout == 'cards' %}
  <table style="width:100%;table-layout:fixed;border-collapse:separate;border-spacing:0 2.5mm;margin-top:-2.5mm">
  {% for row in result.areas|batch(2) %}
    <tr>
    {% for area in row %}
      {% if not loop.first %}<td style="width:3%;padding:0"></td>{% endif %}
      <td style="width:48.5%;padding:0;vertical-align:top">
        <table class="card" style="width:100%;border-collapse:collapse"><tr>
          <td style="width:12mm;padding:2.2mm 0 2.2mm 2.2mm;vertical-align:top">{{ pdf.badge(area.grade ?: '–', 9, 11, t.grade_bg[area.grade], t.grade_ink[area.grade], '2.5mm') }}</td>
          <td style="padding:2.2mm;vertical-align:top"><b style="display:block;font-size:9.5pt;color:{{ t.primary }}">{{ t.labels.area[area.key] ?? area.label }}</b><p style="font-size:8.2pt;margin:.5mm 0 0;line-height:1.3">{{ area.summary }}</p>{% if block.show_meta and area.meta %}<small class="mono" style="display:block;font-size:7.5pt;color:{{ t.muted }};margin-top:1mm">{{ area.meta }}</small>{% endif %}</td>
        </tr></table>
      </td>
      {% if loop.last and loop.index == 1 %}<td style="width:3%;padding:0"></td><td style="width:48.5%;padding:0;vertical-align:top">{% if block.legend %}{{ legendHtml }}{% endif %}</td>{% endif %}
    {% endfor %}
    </tr>
  {% endfor %}
  {% if block.legend and result.areas|length is even %}<tr><td style="width:48.5%;padding:0;vertical-align:top">{{ legendHtml }}</td><td style="width:3%;padding:0"></td><td style="width:48.5%"></td></tr>{% endif %}
  </table>
{% else %}
  {% for area in result.areas %}
  <table class="card" style="width:100%;border-collapse:collapse;margin-bottom:2mm"><tr>
    <td style="width:12mm;padding:2mm 0 2mm 2.5mm;vertical-align:middle">{{ pdf.badge(area.grade ?: '–', 8, 10, t.grade_bg[area.grade], t.grade_ink[area.grade], '2mm') }}</td>
    <td style="padding:2mm 2.5mm;vertical-align:middle"><b style="color:{{ t.primary }}">{{ t.labels.area[area.key] ?? area.label }}</b> <span style="font-size:8.5pt">– {{ area.summary }}</span></td>
  </tr></table>
  {% endfor %}
  {% if block.legend %}{% if block.legend_text %}<p style="font-size:7.5pt;color:{{ t.muted }};margin:2mm 0 0">{{ block.legend_text|nl2br }}</p>{% endif %}{{ pdf.legend(t, t.labels.grade) }}{% endif %}
{% endif %}
</div>
