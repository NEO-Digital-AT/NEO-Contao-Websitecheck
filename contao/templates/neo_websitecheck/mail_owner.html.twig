{% extends '@Contao/neo_websitecheck/_mail_base.html.twig' %}
{% trans_default_domain 'neo_websitecheck' %}
{% block title %}{{ 'mail.owner_subject'|trans({'%domain%': result.domain, '%grade%': result.grade, '%name%': first_name ~ ' ' ~ last_name, '%newsletter%': newsletter ? '+NL' : ''}) }}{% endblock %}
{% block body %}
  {% set p = brand.color_primary %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px;background:#fff8e6;border:1px solid #ffd27a;border-radius:12px;"><tr><td style="padding:14px 16px;font-size:14px;line-height:1.7;">
    <b style="color:{{ p }};">{{ 'mail.owner_lead_title'|trans }}</b><br>
    {{ first_name }} {{ last_name }} · <a href="mailto:{{ email }}" style="color:{{ p }};">{{ email }}</a><br>
    {{ result.domain }} · {{ 'report.grade_line'|trans({'%grade%': result.grade, '%word%': result.gradeWord}) }}<br>
    {{ 'mail.owner_newsletter'|trans }}: {{ (newsletter ? 'word.yes' : 'word.no')|trans }}
  </td></tr></table>
  <p style="margin:0 0 10px;"><b>{{ 'mail.owner_areas'|trans }}</b></p>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:14px;margin-bottom:18px;">
    {% for area in result.areas %}<tr><td style="padding:4px 0;width:28px;"><b>{{ area.grade ?: '–' }}</b></td><td style="padding:4px 0;"><b>{{ area.label }}</b> – {{ area.summary }}</td></tr>{% endfor %}
  </table>
  {% if result.measures %}
  <p style="margin:0 0 8px;"><b>{{ 'mail.measures_title'|trans }}</b></p>
  <ol style="margin:0 0 20px;padding-left:22px;font-size:14px;">{% for m in result.measures %}<li style="margin-bottom:6px;"><b>{{ m.title }}</b> – {{ m.text }} <i>({{ ('measure.effort.' ~ m.effort)|trans }})</i></li>{% endfor %}</ol>
  {% endif %}
  {% if result.errors %}<p style="font-size:13px;color:#8a5a00;">{{ 'mail.owner_errors'|trans }}: {{ result.errors|json_encode }}</p>{% endif %}
{% endblock %}
{% block footer %}{{ 'mail.owner_footer'|trans({'%id%': check.id}) }}{% endblock %}
