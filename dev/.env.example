# Copy to .env — every value is optional.
CONTAO_VERSION=5.3.*
ADMIN_PASSWORD=admin12345
ADMIN_EMAIL=admin@example.com
SITE_LANGUAGE=de

# Without a PageSpeed key Google allows only a handful of anonymous requests per day.
NEO_WEBSITECHECK_PSI_KEY=
# Empty = the AI step is skipped (heuristics only).
NEO_WEBSITECHECK_AI_KEY=
NEO_WEBSITECHECK_AI_BASE_URL=https://router.requesty.ai/v1
NEO_WEBSITECHECK_AI_MODEL=anthropic/claude-sonnet-4-5
# Your copy of every report (lead data). Mailpit shows it regardless of the address.
NEO_WEBSITECHECK_NOTIFY=owner@example.com
# dompdf | gotenberg (start with: docker compose --profile gotenberg up)
PDF_ENGINE=dompdf
